; Configuración del proyecto Cultivo.
; Editado a mano; el editor puede reescribir este archivo al guardar ajustes.
; Las constantes del juego no viven acá: están en src/core/config.gd.

config_version=5

[application]

config/name="Cultivo"
config/description="Instalación musical jugable para el arcumai."
run/main_scene="res://src/view/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

